APP_ID="org.outershell.Profile"
APP_NAME="Profile"
APP_STAGE_NAME="Profile"
XCODE_PROJECT="Profile.xcodeproj"
XCODE_SCHEME="Profile"
XCODE_PRODUCT_NAME="Profile"
BUNDLE_ARCHIVE_SCRIPT="Scripts/archive_profile_bundle.sh"
BUNDLE_ARCHIVE_STEM="ProfileContent.bundle"
BACKEND_SOURCE="Backend/main.c"
BACKEND_EXECUTABLE_NAME="ProfileBackend"
BACKEND_CFLAGS="-std=gnu17 -Os -ffunction-sections -fdata-sections -flto"
BACKEND_LDFLAGS="-ldl -lpthread -lm"
DEFAULT_DEPLOY_SCOPE="user"
ROOT_ONLY="false"
